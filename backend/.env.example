# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/teashop_db

# Security & JWT Token Configuration
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Environment Mode
ENVIRONMENT=development

# Admin Registration Authorization Secret Key
ADMIN_REGISTRATION_SECRET=CHAIFLOW_ADMIN_SECRET_2026

# OTP & SMS Provider Configuration
# Supported providers: console (development mock), twilio, fast2sms, mock
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
